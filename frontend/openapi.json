{
  "openapi": "3.1.0",
  "info": {
    "title": "AlphaLens API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Register",
        "description": "Register a new user account with Argon2 password hashing.",
        "operationId": "register_api_auth_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "description": "Authenticate credentials and issue access, refresh, and CSRF cookies.",
        "operationId": "login_api_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Refresh Session",
        "description": "Rotate refresh token and issue new access token. Detects token reuse.",
        "operationId": "refresh_session_api_auth_refresh_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Refresh Session Api Auth Refresh Post"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Logout",
        "description": "Revoke refresh token and clear all auth cookies.",
        "operationId": "logout_api_auth_logout_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Logout Api Auth Logout Post"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Get Me",
        "description": "Return currently authenticated user profile.",
        "operationId": "get_me_api_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/tickers": {
      "get": {
        "tags": [
          "tickers"
        ],
        "summary": "Autocomplete Tickers",
        "description": "Autocomplete over Nifty 100 historical constituents, returning at most 10 results.",
        "operationId": "autocomplete_tickers_api_tickers_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 50,
              "description": "Search query by symbol or company name",
              "default": "",
              "title": "Q"
            },
            "description": "Search query by symbol or company name"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TickerInfo"
                  },
                  "title": "Response Autocomplete Tickers Api Tickers Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/reports/{ticker}/quant": {
      "get": {
        "tags": [
          "reports"
        ],
        "summary": "Get Quant Report",
        "description": "Retrieve precomputed quantitative metrics from local store (instant, <300ms).\n\nDeliberately decoupled from any live fetch or LLM processing.",
        "operationId": "get_quant_report_api_reports__ticker__quant_get",
        "parameters": [
          {
            "name": "ticker",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "NSE Ticker symbol",
              "title": "Ticker"
            },
            "description": "NSE Ticker symbol"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuantReportResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/reports/{ticker}/evidence/stream": {
      "get": {
        "tags": [
          "reports"
        ],
        "summary": "Stream Evidence Report",
        "description": "Stream verified LLM evidence statements via Server-Sent Events (SSE).",
        "operationId": "stream_evidence_report_api_reports__ticker__evidence_stream_get",
        "parameters": [
          {
            "name": "ticker",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "NSE Ticker symbol",
              "title": "Ticker"
            },
            "description": "NSE Ticker symbol"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/uploads": {
      "get": {
        "tags": [
          "uploads"
        ],
        "summary": "List User Uploads",
        "description": "List all research documents uploaded by the authenticated user.",
        "operationId": "list_user_uploads_api_uploads_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/UploadResponse"
                  },
                  "type": "array",
                  "title": "Response List User Uploads Api Uploads Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "uploads"
        ],
        "summary": "Upload Document",
        "description": "Upload and verify research PDF document.\n\nEnforces 20 MB size limit, PDF magic bytes check, page limit, and stores file under a random UUID.",
        "operationId": "upload_document_api_uploads_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_document_api_uploads_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/uploads/{upload_id}": {
      "delete": {
        "tags": [
          "uploads"
        ],
        "summary": "Delete User Upload",
        "description": "Delete an upload record and its underlying stored file. Returns 404 if not found or unauthorized.",
        "operationId": "delete_user_upload_api_uploads__upload_id__delete",
        "parameters": [
          {
            "name": "upload_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Upload Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Delete User Upload Api Uploads  Upload Id  Delete"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/history": {
      "get": {
        "tags": [
          "history"
        ],
        "summary": "Get User History",
        "description": "Retrieve paginated list of served predictions for the authenticated user.",
        "operationId": "get_user_history_api_history_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HistoryItem"
                  },
                  "title": "Response Get User History Api History Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/profile": {
      "get": {
        "tags": [
          "profile"
        ],
        "summary": "Get Profile",
        "description": "Retrieve user investment preferences.",
        "operationId": "get_profile_api_profile_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "profile"
        ],
        "summary": "Update Profile",
        "description": "Update user investment profile.",
        "operationId": "update_profile_api_profile_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfilePayload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/me/data": {
      "delete": {
        "tags": [
          "profile"
        ],
        "summary": "Delete My Data",
        "description": "Permanently delete user account and uploaded documents, and pseudonymise prediction records.\n\nRequires explicit confirmation payload {\"confirmation\": \"DELETE\"}.",
        "operationId": "delete_my_data_api_me_data_delete",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteDataRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Delete My Data Api Me Data Delete"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/calibration": {
      "get": {
        "tags": [
          "calibration"
        ],
        "summary": "Get Calibration Metrics",
        "description": "Retrieve calibration-curve bins and Brier score over time.\n\nPublic across all logged-in users; aggregates resolved predictions.",
        "operationId": "get_calibration_metrics_api_calibration_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalibrationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health Check",
        "description": "Health check endpoint.",
        "operationId": "health_check_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Check Api Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/{full_path}": {
      "get": {
        "summary": "Spa Fallback",
        "operationId": "spa_fallback__full_path__get",
        "parameters": [
          {
            "name": "full_path",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Full Path"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Spa Fallback  Full Path  Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_upload_document_api_uploads_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "Research document (PDF only)"
          },
          "consent": {
            "type": "boolean",
            "title": "Consent",
            "description": "Required consent that document will be processed for analysis"
          }
        },
        "type": "object",
        "required": [
          "file",
          "consent"
        ],
        "title": "Body_upload_document_api_uploads_post"
      },
      "BrierPoint": {
        "properties": {
          "date": {
            "type": "string",
            "title": "Date"
          },
          "brier_score": {
            "type": "number",
            "title": "Brier Score"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "date",
          "brier_score"
        ],
        "title": "BrierPoint",
        "description": "Historical Brier score observation."
      },
      "CalibrationBin": {
        "properties": {
          "bin_center": {
            "type": "number",
            "title": "Bin Center"
          },
          "predicted_avg": {
            "type": "number",
            "title": "Predicted Avg"
          },
          "empirical_frequency": {
            "type": "number",
            "title": "Empirical Frequency"
          },
          "sample_count": {
            "type": "integer",
            "title": "Sample Count"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "bin_center",
          "predicted_avg",
          "empirical_frequency",
          "sample_count"
        ],
        "title": "CalibrationBin",
        "description": "Reliability curve probability bin."
      },
      "CalibrationResponse": {
        "properties": {
          "bins": {
            "items": {
              "$ref": "#/components/schemas/CalibrationBin"
            },
            "type": "array",
            "title": "Bins"
          },
          "brier_history": {
            "items": {
              "$ref": "#/components/schemas/BrierPoint"
            },
            "type": "array",
            "title": "Brier History"
          },
          "overall_brier_score": {
            "type": "number",
            "title": "Overall Brier Score"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "bins",
          "brier_history",
          "overall_brier_score"
        ],
        "title": "CalibrationResponse",
        "description": "Model calibration curve and Brier score over time."
      },
      "ConfidenceInterval": {
        "properties": {
          "lower": {
            "type": "number",
            "title": "Lower"
          },
          "upper": {
            "type": "number",
            "title": "Upper"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "lower",
          "upper"
        ],
        "title": "ConfidenceInterval",
        "description": "Lower and upper confidence intervals."
      },
      "DeleteDataRequest": {
        "properties": {
          "confirmation": {
            "type": "string",
            "title": "Confirmation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "confirmation"
        ],
        "title": "DeleteDataRequest",
        "description": "Confirmation payload requiring exact string 'DELETE'."
      },
      "FactorContribution": {
        "properties": {
          "factor": {
            "type": "string",
            "title": "Factor"
          },
          "contribution": {
            "type": "number",
            "title": "Contribution"
          },
          "score": {
            "type": "number",
            "title": "Score"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "factor",
          "contribution",
          "score"
        ],
        "title": "FactorContribution",
        "description": "Contribution of an individual quant factor."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HistoryItem": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "ticker": {
            "type": "string",
            "title": "Ticker"
          },
          "probability": {
            "type": "number",
            "title": "Probability"
          },
          "decision_label": {
            "type": "string",
            "title": "Decision Label"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "outcome": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Outcome"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "ticker",
          "probability",
          "decision_label",
          "model_version",
          "outcome",
          "created_at"
        ],
        "title": "HistoryItem",
        "description": "User prediction history item."
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "description": "User login payload."
      },
      "ProfilePayload": {
        "properties": {
          "risk_level": {
            "$ref": "#/components/schemas/RiskLevel",
            "default": "moderate"
          },
          "investment_horizon_months": {
            "type": "integer",
            "enum": [
              3,
              6,
              12
            ],
            "title": "Investment Horizon Months",
            "default": 6
          },
          "sector_exclusions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sector Exclusions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ProfilePayload",
        "description": "User investment profile payload."
      },
      "ProfileResponse": {
        "properties": {
          "risk_level": {
            "type": "string",
            "title": "Risk Level"
          },
          "investment_horizon_months": {
            "type": "integer",
            "title": "Investment Horizon Months"
          },
          "sector_exclusions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sector Exclusions"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "risk_level",
          "investment_horizon_months",
          "sector_exclusions"
        ],
        "title": "ProfileResponse",
        "description": "User profile response."
      },
      "QuantReportResponse": {
        "properties": {
          "ticker": {
            "type": "string",
            "title": "Ticker"
          },
          "probability": {
            "type": "number",
            "title": "Probability"
          },
          "confidence_interval": {
            "$ref": "#/components/schemas/ConfidenceInterval"
          },
          "decision_label": {
            "type": "string",
            "title": "Decision Label"
          },
          "as_of": {
            "type": "string",
            "title": "As Of"
          },
          "factor_contributions": {
            "items": {
              "$ref": "#/components/schemas/FactorContribution"
            },
            "type": "array",
            "title": "Factor Contributions"
          },
          "scenarios": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ScenarioDetail"
            },
            "type": "object",
            "title": "Scenarios"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ticker",
          "probability",
          "confidence_interval",
          "decision_label",
          "as_of",
          "factor_contributions",
