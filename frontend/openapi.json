{
  "openapi": "3.1.0",
  "info": {
    "title": "AlphaLens API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Register",
        "description": "Register a new user account with Argon2 password hashing.",
        "operationId": "register_api_auth_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "description": "Authenticate credentials and issue access, refresh, and CSRF cookies.",
        "operationId": "login_api_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Refresh Session",
        "description": "Rotate refresh token and issue new access token. Detects token reuse.",
        "operationId": "refresh_session_api_auth_refresh_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Refresh Session Api Auth Refresh Post"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Logout",
        "description": "Revoke refresh token and clear all auth cookies.",
        "operationId": "logout_api_auth_logout_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Logout Api Auth Logout Post"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Get Me",
        "description": "Return currently authenticated user profile.",
        "operationId": "get_me_api_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/tickers": {
      "get": {
        "tags": [
          "tickers"
        ],
        "summary": "Autocomplete Tickers",
        "description": "Autocomplete over Nifty 100 historical constituents, returning at most 10 results.",
        "operationId": "autocomplete_tickers_api_tickers_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 50,
              "description": "Search query by symbol or company name",
              "default": "",
              "title": "Q"
            },
            "description": "Search query by symbol or company name"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TickerInfo"
                  },
                  "title": "Response Autocomplete Tickers Api Tickers Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/reports/{ticker}/quant": {
      "get": {
        "tags": [
          "reports"
        ],
        "summary": "Get Quant Report",
        "description": "Retrieve precomputed quantitative metrics from local store (instant, <300ms).\n\nDeliberately decoupled from any live fetch or LLM processing.",
        "operationId": "get_quant_report_api_reports__ticker__quant_get",
        "parameters": [
          {
            "name": "ticker",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "NSE Ticker symbol",
              "title": "Ticker"
            },
            "description": "NSE Ticker symbol"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuantReportResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/reports/{ticker}/evidence/stream": {
      "get": {
        "tags": [
          "reports"
        ],
        "summary": "Stream Evidence Report",
        "description": "Stream verified LLM evidence statements via Server-Sent Events (SSE).",
        "operationId": "stream_evidence_report_api_reports__ticker__evidence_stream_get",
        "parameters": [
          {
            "name": "ticker",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "NSE Ticker symbol",
              "title": "Ticker"
            },
            "description": "NSE Ticker symbol"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Health Check",
        "description": "Health check endpoint.",
        "operationId": "health_check_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Check Api Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/{full_path}": {
      "get": {
        "summary": "Spa Fallback",
        "operationId": "spa_fallback__full_path__get",
        "parameters": [
          {
            "name": "full_path",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Full Path"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Spa Fallback  Full Path  Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConfidenceInterval": {
        "properties": {
          "lower": {
            "type": "number",
            "title": "Lower"
          },
          "upper": {
            "type": "number",
            "title": "Upper"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "lower",
          "upper"
        ],
        "title": "ConfidenceInterval",
        "description": "Lower and upper confidence intervals."
      },
      "FactorContribution": {
        "properties": {
          "factor": {
            "type": "string",
            "title": "Factor"
          },
          "contribution": {
            "type": "number",
            "title": "Contribution"
          },
          "score": {
            "type": "number",
            "title": "Score"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "factor",
          "contribution",
          "score"
        ],
        "title": "FactorContribution",
        "description": "Contribution of an individual quant factor."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "description": "User login payload."
      },
      "QuantReportResponse": {
        "properties": {
          "ticker": {
            "type": "string",
            "title": "Ticker"
          },
          "probability": {
            "type": "number",
            "title": "Probability"
          },
          "confidence_interval": {
            "$ref": "#/components/schemas/ConfidenceInterval"
          },
          "decision_label": {
            "type": "string",
            "title": "Decision Label"
          },
          "as_of": {
            "type": "string",
            "title": "As Of"
          },
          "factor_contributions": {
            "items": {
              "$ref": "#/components/schemas/FactorContribution"
            },
            "type": "array",
            "title": "Factor Contributions"
          },
          "scenarios": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ScenarioDetail"
            },
            "type": "object",
            "title": "Scenarios"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ticker",
          "probability",
          "confidence_interval",
          "decision_label",
          "as_of",
          "factor_contributions",
          "scenarios",
          "model_version"
        ],
        "title": "QuantReportResponse",
        "description": "Complete Tier 1 quantitative evaluation response."
      },
      "RegisterRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "title": "Password",
            "description": "Password must be at least 12 characters"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "RegisterRequest",
        "description": "User registration payload."
      },
      "ScenarioDetail": {
        "properties": {
          "return_pct": {
            "type": "number",
            "title": "Return Pct"
          },
          "description": {
            "type": "string",
            "title": "Description"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "return_pct",
          "description"
        ],
        "title": "ScenarioDetail",
        "description": "Scenario return expectation and thesis statement."
      },
      "TickerInfo": {
        "properties": {
          "symbol": {
            "type": "string",
            "pattern": "^[A-Z0-9_\\-&]+\\.NS$",
            "title": "Symbol",
            "description": "NSE ticker symbol ending with .NS suffix",
            "examples": [
              "TCS.NS",
              "RELIANCE.NS"
            ]
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "sector": {
            "type": "string",
            "title": "Sector"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "symbol",
          "name",
          "sector"
        ],
        "title": "TickerInfo",
        "description": "Ticker item returned for autocomplete and universe lookups."
      },
      "UserResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "is_active": {
            "type": "boolean",
            "title": "Is Active"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "email",
          "role",
          "is_active",
          "created_at"
        ],
        "title": "UserResponse",
        "description": "User profile response without sensitive data."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}